# Copy to .env. Empty key keeps the clearly labelled instruction fallback active.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=15
# For an OpenAI-compatible local server without authentication, use a nonempty dummy key.
# Example Ollama URL from Docker: http://host.docker.internal:11434/v1
# Use the exact model ID and API URL supplied by AI Tunnel or another provider.
APP_PORT=5000
